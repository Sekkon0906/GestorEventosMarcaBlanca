# Copiar a .env.local y reemplazar con valores reales del proyecto Supabase
# Dashboard > Project Settings > API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL base del backend Express si todavía se usa para otros endpoints
VITE_API_URL=http://localhost:3000

# Mapbox (pk.* es token público — restricción por dominio en mapbox.com/account/tokens)
VITE_MAPBOX_TOKEN=pk.ey...
